<header class="container">
  <h1>RAG Chatbot</h1>
</header>

<main class="container">
  <article>
    <h2>Add a document</h2>
    <p>Paste a document's text to add it to the knowledge base. The text is split into chunks and indexed for search.</p>

    <%= form_with url: ingest_path, method: :post do |form| %>
      <label for="ingest_text">Document text</label>
      <%= form.text_area :text, id: "ingest_text", rows: 10, required: true, aria: { describedby: "ingest_text_help" } %>
      <small id="ingest_text_help">The text is split into chunks and indexed for search.</small>

      <%= form.submit "Add document", class: "contrast" %>
    <% end %>
  </article>
</main>